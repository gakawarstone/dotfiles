#!/bin/bash

# deps for wayland
# grim slurp wl-clipboard 

capture_wayland() {
    local path=~/Images/screenshot.png
    local selection geometry

    if [ "$1" = "root" ]; then
        grim -t png "$path" || return 1
    elif [ "$1" = "area" ]; then
        if ! command -v slurp >/dev/null; then
            echo "Error: slurp is required for area selection in Wayland"
            return 1
        fi
        selection=$(slurp) || return 1
        [ -n "$selection" ] || return 1
        geometry=$(printf '%s\n' "$selection" | awk '{
            split($1, a, ",");
            split($2, b, "x");
            printf "%d,%d %dx%d", a[1]+1, a[2]+1, b[1]-2, b[2]-2
        }') || return 1
        grim -t png -g "$geometry" "$path" || return 1
    else
        echo "Usage: screen root|area" >&2
        return 2
    fi
    wl-copy < "$path"
}

capture_x11() {
    if [ "$1" = "root" ]; then
        xwd -root -out ~/Images/screenshot.xwd || return 1
    elif [ "$1" = "area" ]; then
        import ~/Images/screenshot.xwd || return 1
    else
        echo "Usage: screen root|area" >&2
        return 2
    fi
    convert ~/Images/screenshot.xwd ~/Images/screenshot.jpg || return 1
    rm ~/Images/screenshot.xwd || return 1
    xclip -sel clipboard -t image/jpg < ~/Images/screenshot.jpg
}

if [ "$XDG_SESSION_TYPE" = "wayland" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    capture_wayland "$1"
else
    capture_x11 "$1"
fi
