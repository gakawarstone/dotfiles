#!/usr/bin/env bash
set -euo pipefail

fail() { printf '%s\n' "$*" >&2; exit 1; }

device="${MOBILE_SCREEN_DEVICE:-ipad}"
case "$device" in
    ipad) output=IPAD; workspace=5; label=iPad; port=47989 ;;
    iphone) output=IPHONE; workspace=6; label=iPhone; port=48089 ;;
    *) fail "Unknown mobile screen: $device" ;;
esac
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/sunshine-$device"
lua_config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/$device.lua"
unit="$device-screen.service"
has_screen() { hyprctl monitors -j | jq -e --arg output "$output" 'any(.[]; .name == $output)' >/dev/null; }

remove_screen() {
    has_screen || return 0
    local fallback fallback_lua workspace
    fallback=$(hyprctl monitors -j | jq -r '
        [.[] | select(.name != "IPAD" and .name != "IPHONE")]
        | (map(select(.name == "HDMI-A-1"))[0] // .[0]).name // empty')
    [[ -n "$fallback" ]] || fail "No physical monitor available; keeping $output."
    fallback_lua=$(jq -nr --arg name "$fallback" '$name | @json')
    while IFS= read -r workspace; do
        hyprctl eval "hl.dispatch(hl.dsp.workspace.move({ workspace = $workspace, monitor = $fallback_lua }))" >/dev/null
    done < <(hyprctl workspaces -j | jq -r --arg output "$output" '.[] | select(.monitor == $output) | .name | @json')
    # Removing the output also relocates any windows created during cleanup.
    hyprctl output remove "$output" >/dev/null
    ! has_screen || fail "Could not remove $output."
}

case "${1:-status}" in
    on)
        command -v sunshine >/dev/null || fail "Install first: bash ~/dotfiles/scripts/install_${device}_screen.sh"
        [[ -r "$config_dir/sunshine.conf" && -r "$lua_config" ]] || fail "Run install_${device}_screen.sh first."
        [[ -n "${WAYLAND_DISPLAY:-}" ]] || fail "Run this command inside your Hyprland session."
        if [[ "$device" == iphone ]]; then
            orientation="${2:-sideways}"
            case "$orientation" in portrait|landscape|sideways) ;; *) fail "Usage: iphone-screen on [portrait|landscape|sideways]" ;; esac
            printf '%s\n' "$orientation" > "${XDG_RUNTIME_DIR:?}/iphone-screen.orientation"
        fi
        lua_path=$(jq -nr --arg path "$lua_config" '$path | @json')
        if systemctl --user is-active --quiet "$unit" && has_screen; then
            if [[ "$device" == iphone ]]; then
                hyprctl eval "dofile($lua_path)" >/dev/null
                printf 'iPhone screen: %s. Reconnect Moonlight with the matching resolution.\n' "$orientation"
            else
                printf 'iPad screen is already on.\n'
            fi
            exit 0
        fi
        if [[ -n $(ss -H -ltn "( sport = :$port or sport = :$((port + 1)) or sport = :$((port - 5)) or sport = :$((port + 21)) )") ]]; then
            fail "Sunshine ports for $label are already in use. Check existing Sunshine instances."
        fi
        hyprctl eval "dofile($lua_path)" >/dev/null
        created=false
        if ! has_screen; then
            hyprctl output create headless "$output" >/dev/null
            created=true
        fi
        has_screen || fail "Hyprland did not create $output."
        # Reattach the workspace if it was moved back to a physical monitor on off.
        if hyprctl workspaces -j | jq -e --arg workspace "$workspace" 'any(.[]; .name == $workspace)' >/dev/null; then
            hyprctl eval "hl.dispatch(hl.dsp.workspace.move({ workspace = \"$workspace\", monitor = \"$output\" }))" >/dev/null
        fi
        if ! systemd-run --user --quiet --collect --unit="$unit" --property=Type=exec \
            --setenv="WAYLAND_DISPLAY=$WAYLAND_DISPLAY" \
            --setenv="DISPLAY=${DISPLAY:-}" \
            --setenv="XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-Hyprland}" \
            --setenv="XDG_SESSION_TYPE=wayland" \
            --setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
            "$(command -v sunshine)" "$config_dir/sunshine.conf"; then
            if "$created"; then remove_screen; fi
            fail "Sunshine did not start. Check: journalctl --user -u $unit -n 50"
        fi
        sleep 1
        if ! systemctl --user is-active --quiet "$unit"; then
            if "$created"; then remove_screen; fi
            fail "Sunshine exited. Check: journalctl --user -u $unit -n 50"
        fi
        hyprctl monitors -j | jq -r --arg output "$output" '.[] | select(.name == $output) | "\(.name): \(.width)x\(.height), \(.refreshRate) Hz, scale \(.scale), workspace \(.activeWorkspace.name)."'
        printf 'Setup: https://localhost:%s\n' "$((port + 1))"
        ip -4 route get 1.1.1.1 2>/dev/null | awk -v port="$port" '{for (i=1;i<=NF;i++) if ($i=="src") print "Moonlight host: " $(i+1) ":" port}' || true
        ;;
    off)
        if systemctl --user is-active --quiet "$unit"; then
            systemctl --user stop "$unit"
        fi
        remove_screen
        printf '%s screen is off.\n' "$label"
        ;;
    status)
        if has_screen; then
            hyprctl monitors -j | jq --arg output "$output" '.[] | select(.name == $output) | {name, width, height, refreshRate, scale, x, y, activeWorkspace}'
        else
            printf '%s monitor: off\n' "$output"
        fi
        if systemctl --user is-active --quiet "$unit"; then
            printf 'Sunshine: running\n'
        else
            printf 'Sunshine: stopped\n'
        fi
        ;;
    logs) journalctl --user -u "$unit" -n 80 --no-pager ;;
    *) fail "Usage: $device-screen [on|off|status|logs]" ;;
esac
