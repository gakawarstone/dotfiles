{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "strict": {
      "description": "Strict mode, ask for edits and bash",
      "mode": "primary",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        }
      ]
    }
  }
}
