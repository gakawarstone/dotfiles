{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-wakatime"],
  "agent": {
    "strict": {
      "description": "Strict mode, ask for edits and bash",
      "mode": "primary",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git diff *": "allow",
          "git log *": "allow"
        }
      }
    }
  }
}
